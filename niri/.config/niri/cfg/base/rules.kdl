    // global window rules
    window-rule {
        geometry-corner-radius 12
        clip-to-geometry true
        draw-border-with-background false
        opacity 0.95
        background-effect {
            blur true
            xray true
        }
    }

    window-rule {
        match is-focused=false
        opacity 0.9
    }

    window-rule {
        match is-floating=true

        background-effect {
            blur true
            // xray false
        }
    }

    // we think that these rules are useful for most users, so don't modify it.
    // add custom rules in custom/rules.kdl

    // windows special rules

    // Block out two password managers from screen capture.
    window-rule {
        match app-id=r#"^org\.keepassxc\.KeePassXC$"#
        match app-id=r#"^org\.gnome\.World\.Secrets$"#

        block-out-from "screen-capture"

        // Use this instead if you want them visible on third-party screenshot tools.
        // block-out-from "screencast"
    }

    window-rule {
        match app-id=r"^steam_app_.*"   // 匹配所有 Steam 游戏（原生或 Proton）
        match app-id=r"^gamescope$"     // 匹配 Gamescope 微型合成器
        
        open-fullscreen true

        opacity 1.0

        background-effect {
            blur false
        }

        draw-border-with-background false
    }

    // add special rules here
    include "rules/desktop_lyrics.kdl"
    include "rules/osu.kdl"
    include "rules/noctalia.kdl"
    include "rules/steam.kdl"
    include "rules/players.kdl"